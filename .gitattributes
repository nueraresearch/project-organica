# Project Organica stores source and documentation with LF endings.
#
# The engine pin hashes text after newline normalization, and this file keeps a
# Windows checkout from turning pinned modules into different files. Batch files
# stay CRLF because cmd.exe expects that; binary assets are never normalized.
* text=auto

*.py text eol=lf
*.pyi text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.cff text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
