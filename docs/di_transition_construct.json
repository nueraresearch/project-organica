  "onset_conventions": {
    "sustained_cycles": 10,
    "anchor": "first cycle of the qualifying run, never the first non-zero reading",
    "confirmation": "the anchor is confirmed only once the 10th consecutive reading has been recorded",
    "available_from": "the confirmation cycle (anchor + 9) onward; the predictor does not exist before then",
    "assigned_retrospectively": true,
    "interruption_before_confirmation": "a run shorter than 10 ended by a zero does not qualify, does not move the anchor, and the search resumes at the cycle after the zero",
    "interruption_after_confirmation": "does not move a confirmed onset; the event is the first sustained emergence",
    "missing_reading": "counts as not qualifying, so it breaks the run; a missing reading is never read as non-zero",
    "end_boundary": "a run still non-zero where the record ends, with fewer than 10 readings since its last zero, is censored -- never an onset at the boundary"
  },
