        {
          "note_regex": "needs ([0-9]+)–([0-9]+) / ([0-9,]+)",
          "doc": "docs/DECISION-A1-COMPETENT-ESTIMAND.md",
          "doc_regex": "maximum over ([0-9]+)–([0-9]+) deltas per seed, ([0-9,]+) across the block"
