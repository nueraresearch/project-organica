{
  "kind": "a1_board_manifest",
  "version": 1,
  "date": "2026-11-15",
  "note": "Each branch names the record, artifact or act that settles it, and the check that proves it. A branch may also declare note_claims: the numbers its note quotes, and where they must be found, so a restated count cannot drift while the row stays green.",
  "branches": [
    {
      "id": "c1-denominator-definition",
      "branch": "C1 denominator definition",
      "kind": "decision",
      "decision": "DECISION-A1-C1-DENOMINATOR",
      "note": "the recorded cell row, non-target edges included",
      "proved_by": [
        "tests/test_a1_c1_ceiling.py"
      ]
    },
    {
      "id": "c1-denominator-invariance",
      "branch": "C1 denominator invariance",
      "kind": "artifact",
      "artifact": "docs/a1_c8_target_selection_competent.json",
      "contains": [
        {
          "path": "docs/a1_c8_target_selection_competent.json",
          "strings": [
            "c1_min_denominator",
            "79"
          ]
        }
      ],
      "note": "C1 counts every recorded row, so the target set cannot move it; the competent selection reproduces 79/64/79/74/72/74",
      "proved_by": [
        "tests/test_a1_c8_selection_competent.py"
      ],
      "note_claims": [
        {
          "note_regex": "reproduces ([0-9]+(?:/[0-9]+){5})",
          "path": "docs/a1_c8_target_selection_competent.json",
          "field": "per_seed.*.c1.c1_min_denominator"
        }
      ]
    },
    {
      "id": "c1-unit",
      "branch": "C1 unit of evidence",
      "kind": "decision",
      "decision": "DECISION-A1-C1-UNIT",
      "note": "the directed edge; the relation is a declared dependence class on its own denominator",
      "proved_by": [
        "docs/A1-C1-UNIT-OF-EVIDENCE.md"
      ]
    },
    {
      "id": "competence-contract",
      "branch": "Competence contract, N_min, capacity",
      "kind": "decision",
      "decision": "DECISION-A1-C8-NMIN",
      "note": "unit, threshold 0.05, endpoint cap 3, N_min = 17",
      "proved_by": [
        "tests/test_a1_target_viability_adopted.py"
      ],
      "note_claims": [
        {
          "note_regex": "threshold ([0-9.]+)",
          "doc": "docs/DECISION-A1-C8-NMIN.md",
          "doc_regex": "\\|\\s*Threshold\\s*\\|\\s*\\*\\*([0-9.]+)\\*\\* per seed"
        },
        {
          "note_regex": "endpoint cap ([0-9]+)",
          "doc": "docs/DECISION-A1-C8-NMIN.md",
          "doc_regex": "\\|\\s*Endpoint cap\\s*\\|\\s*([0-9]+) selected edges"
        },
        {
          "note_regex": "N_min = ([0-9]+)",
          "doc": "docs/DECISION-A1-C8-NMIN.md",
          "doc_regex": "\\|\\s*\\*\\*N_min\\*\\*\\s*\\|\\s*\\*\\*([0-9]+) rows per seed"
        }
      ]
    },
    {
      "id": "c8-selection-procedure",
      "branch": "C8 selection procedure",
      "kind": "decision",
      "decision": "DECISION-A1-C8-SELECTION",
