  "blocks": [
   "current-16",
   "fresh-16",
   "larger-28"
  ],
  "caps": [
   20,
   40,
   80,
   112
  ],
  "tags": {
   "current-16": 16,
   "fresh-16": 16,
   "larger-28": 28
  },
  "cells": 12,
  "seed_rows": 72,
  "density": "candidate_edges / tags"
 },
 "governance": {
  "freeze": false,
  "grant": false,
  "run": false,
  "authorization": "none"
 },
 "reading": "Density predicts the offset about as well as candidate size at cell level and slightly worse across seeds; with 12 cells and 72 rows none of the three continuous summaries separates from the others, and only K completeness is clearly worse. Candidate density reaches cell LOO 0.0182 and seed LOO 0.0689, against 0.0184 and 0.0667 for candidate size, 0.0193 and 0.0668 for the free block offset, and 0.0189 and 0.0865 for K completeness. The cell-level edge over size (0.0002) and the seed-level gap (0.0023) are both small against the fits' own error. Adding density to size does not help: cell LOO moves from 0.0184 to 0.0193 and seed LOO from 0.0667 to 0.0663, with coefficients [-9.42916961, 4.76918983, -2.5031062, 0.04698668], because density is candidate count divided by a block constant. Across the three blocks the pairs run current-16 (4.1536, 3.9792); fresh-16 (4.1563, 3.9896); larger-28 (5.1156, 5.9524), so every monotone block summary separates the 16-tag blocks from larger-28 equally well. Within larger-28, A coverage correlates -0.013 with density, -0.012 with log candidate size and 0.079 with K completeness, while density and size correlate 1.000. Density is an equally admissible label, not a better one: the data cannot choose between counting candidates and measuring how full the alphabet is, and that choice needs a design that varies one while holding the other.",
