  "rule": {
    "name": "A1-COMPETENCE-FILTER-1",
    "one_line": "Restrict each published selection's eligible set to the rows whose baseline A and K paths are both present, and leave everything else in the rule alone.",
    "steps": [
      "Rebuild the candidate universe exactly as the published rule does: the first 36 acquisition cycles, one orientation per unordered pair.",
      "Apply the published eligibility test: positive cycle-36 U strength and cycle membership.",
      "Add one predicate: both baseline paths, A and K, must be true for that directed edge in the recorded no-arm availability.",
      "Order the remaining edges by ascending sha256('A1-TARGET-1|seed|a>b') \u2014 the published salt, unchanged \u2014 and walk that order, skipping an edge whose endpoint already holds its cap, until n rows are taken.",
      "For this draft the walk is repeated under deterministic shuffles to exhibit the best block that exists at all; the published order is reported beside it, because the two differ.",
      "Stop at n = 4 (endpoint cap 1) or n = 20 (endpoint cap 3). One orientation per pair; no edge repeated.",
      "If fewer than n edges are accepted, the seed forms no target set and the block is VOID. No non-competent row is ever added as a fallback."
    ],
    "unchanged_by_this_draft": [
      "the candidate universe and the 36-cycle boundary",
      "the strength and cycle-member eligibility test",
      "the hash order and its salt",
      "the row counts (4 and 20) and the endpoint caps",
      "every threshold: no gate, floor or criterion moves"
    ],
    "changed_by_this_draft": [
      "which rows are eligible: A-and-K-available only",
      "therefore which rows are selected, on every seed",
      "and, in consequence, the population the C8 result would speak about"
    ]
  },
