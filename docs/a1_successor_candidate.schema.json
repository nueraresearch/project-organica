{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-organica.local/schemas/a1_successor_candidate.schema.json",
  "title": "A1 successor candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "seed_block",
    "targets_in_scope",
    "per_seed",
    "selection",
    "baseline",
    "universe",
    "governance"
  ],
  "properties": {
    "kind": {
      "const": "a1_successor_candidate"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "pattern": "^CANDIDATE SPEC"
    },
    "seed_block": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "targets_in_scope": {
      "type": "boolean"
    },
    "per_seed": {
      "type": "object",
      "minProperties": 6,
      "propertyNames": {
        "pattern": "^[0-9]+$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/row"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen",
        "targets_selected",
        "k_screened",
        "prior_k_exposure"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "u_cycle": {
          "type": "integer",
          "minimum": 1
        },
        "cycles": {
          "type": "integer",
          "minimum": 1
        },
        "one_orientation_per_pair": {
          "const": true
        },
        "boundary_safe": {
          "type": "boolean"
        },
        "boundary_note": {
          "type": "string"
        },
        "screen": {
          "type": "string",
          "minLength": 1
        },
        "targets_selected": {
          "const": 0
        },
        "k_screened": {
          "const": false
        },
        "prior_k_exposure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "cycles",
        "treatment",
        "A",
        "K"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "cycles": {
          "type": "integer",
          "minimum": 1
        },
        "treatment": {
          "const": "none"
        },
        "A": {
          "type": "string"
        },
        "K": {
          "type": "string"
        }
      }
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "selector",
        "runner",
        "scorer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "scorer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_required",
        "freeze",
        "grant",
        "run",
        "authorization"
      ],
      "properties": {
        "preflight_required": {
          "const": true
        },
        "freeze": {
          "const": false
        },
        "grant": {
          "const": false
        },
        "run": {
          "const": false
        },
        "authorization": {
          "const": "none"
        }
      }
    },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seed",
          "candidate_edges",
          "independent_edges",
          "A_available",
          "K_available",
          "A_and_K",
          "selection_status"
        ],
        "properties": {
          "seed": {
            "type": "integer"
          },
          "candidate_edges": {
            "type": "integer",
            "minimum": 0
          },
          "independent_edges": {
            "type": "integer",
            "minimum": 0
          },
          "A_available": {
            "type": "integer",
            "minimum": 0
          },
          "K_available": {
            "type": "integer",
            "minimum": 0
          },
          "A_and_K": {
            "type": "integer",
            "minimum": 0
          },
          "selection_status": {
            "type": "string"
          }
        }
      }
    },
    "not_evidence": {
      "type": "string"
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "A",
        "K"
      ],
      "properties": {
        "edge": {
          "type": "string",
          "pattern": "^[a-z]{4,}>[a-z]{4,}$"
        },
        "A": {
          "type": "boolean"
        },
        "K": {
          "type": "boolean"
        }
      }
    }
  }
}
