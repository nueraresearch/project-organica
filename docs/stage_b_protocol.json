  "analysis": {
    "unit": "one world (seed) within one configuration",
    "estimator": "Spearman rank correlation between confirmed onset and revision_held_out across worlds of one configuration",
    "effect_size_beside_it": "OLS slope of standardised outcome on standardised onset",
    "interval": "percentile bootstrap resampling worlds within the configuration, 0.9833 level, 10,000 replicates",
    "pooling": "none; every configuration is reported alone and no pooled coefficient may be quoted",
    "aggregation_rule": "the construct is supported only if the predicted relation holds with an interval excluding zero in every claimed configuration. Holding in some and not others is reported as mixed and is not supported as stated",
    "permutation_control": "onset shuffled across worlds within the configuration; the interval must include zero",
    "size_baseline": "the same estimator with structural size in place of onset, reported beside it"
  },
  "falsifiers": [
    {
      "id": "A",
      "name": "Absence",
      "statement": "a within-configuration interval containing zero in any claimed configuration leaves the construct unsupported"
    },
    {
      "id": "B",
      "name": "Reversal",
      "statement": "a relation with the opposite sign is recorded as reversed, which is stronger than unsupported"
    },
    {
      "id": "C",
      "name": "Dead configuration",
      "statement": "onset undefined in most runs of a configuration is a world property, reported as such and never as a null"
    },
    {
      "id": "D",
      "name": "Pooled only",
      "statement": "a relation across configurations but not inside one does not answer the protocol's question and does not support the construct"
    }
  ],
  "outcomes": {
    "supported": "present with the predicted sign in every claimed configuration, size baseline and permutation both null",
    "mixed": "present in some, absent in others; not supported as stated",
    "not_supported": "absent in every configuration",
    "reversed": "reversed in any configuration, recorded there",
    "size_effect": "explained by structural size rather than onset",
    "design_defect": "permutation control non-null, or a predictor built from behavioural cycles; no result is reported",
    "inconclusive": "fewer usable worlds than the floor after censoring"
  },
